{
  "name": "wpjsapi-lib",
  "version": "3.1.2",
  "description": "Library to use WordPress REST API easily in any JS project",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ayach90/wpjs-api.git"
  },
  "keywords": [
    "WordPress",
    "JS",
    "API",
    "REST",
    "API"
  ],
  "author": "Àngel Ayach Boadas",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ayach90/wpjsapi/issues"
  },
  "homepage": "https://github.com/Ayach90/wpjsapi#readme",
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
